# Base das chamadas REST (Axios). Relativo: interceptado pelo MSW quando os mocks estão ativos.
VITE_API_URL=/api

# Servidor Socket.IO. Com mocks ativos é interceptado pelo MSW (@mswjs/socket.io-binding).
# Vazio: o cliente usa o origin da página (com mocks, o MSW intercepta nesse mesmo endereço).
VITE_WS_URL=

# Liga a camada de mocks (MSW). Também deve ficar "true" no build de demonstração.
VITE_ENABLE_MOCKS=true

# Cenário inicial dos mocks (ver mocks/scenarios). Hoje: default
VITE_MOCK_SCENARIO=default
